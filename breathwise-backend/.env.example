# Server port (Cloud Run injects PORT automatically; default 8080 locally)
PORT=8080

# Google Gemini API key (leave empty to verify deterministic offline fallbacks)
GEMINI_API_KEY=

# Gemini model name
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
